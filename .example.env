# Local development defaults. Copy this file to .env and adjust as needed.
NWM_BIND_ADDRESS=0.0.0.0:8080
NWM_DATA_DIR=./data
NWM_ADMIN_USERNAME=admin
NWM_ADMIN_PASSWORD=admin
RUST_LOG=nwm=debug,tower_http=debug

# Optional. When omitted, this is derived from NWM_DATA_DIR.
# NWM_DATABASE_URL=sqlite://./data/nut-web-manager.db?mode=rwc
